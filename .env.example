# ─────────────────────────────────────────────────────────────────────────
#  RISE UP ACADEMIA — variáveis de ambiente
#  Copie para .env e ajuste. NUNCA comite o .env.
# ─────────────────────────────────────────────────────────────────────────

# Domínio público. Entra em canonical, sitemap, robots e Open Graph.
# Sem barra no final. LIDA NO BUILD — mudou, refaça o deploy.
NEXT_PUBLIC_SITE_URL=https://riseupacademia.com.br

# "true" tira o site do índice dos buscadores. Use true enquanto for prévia.
# LIDA NO BUILD — mudou, refaça o deploy.
NEXT_PUBLIC_MODO_PREVIA=true

# Caminho do banco SQLite. No contêiner aponta para o volume.
DATABASE_URL=/app/dados/riseup.db

# Cofre dos segredos (tokens do Strava). Mínimo 32 caracteres aleatórios.
# Gere com: openssl rand -base64 48
# ⚠️ Trocar esta chave torna ilegíveis as conexões já salvas.
RISEUP_CHAVE_SEGREDOS=

# Dados de demonstração no primeiro boot (contas de teste, treinos, receitas).
# Só age se o banco estiver vazio. Deixe false em produção real.
RISEUP_SEMEAR_DEMO=false

# Strava — criar em https://www.strava.com/settings/api
# Callback: https://SEU-DOMINIO/api/strava/retorno
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Porta do servidor (o EasyPanel normalmente injeta).
PORT=3000
