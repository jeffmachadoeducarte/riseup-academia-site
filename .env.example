# Domínio público do site — entra em canonical, sitemap, robots e Open Graph.
# Sem barra no final.
NEXT_PUBLIC_SITE_URL=https://riseupacademia.com.br

# Modo prévia: "true" tira o site do índice dos buscadores.
# Use "true" enquanto estiver em URL temporária.
# Troque para "false" APENAS no deploy do domínio definitivo (exige rebuild).
NEXT_PUBLIC_MODO_PREVIA=true

# Porta do servidor (o EasyPanel normalmente injeta esta variável).
PORT=3000
