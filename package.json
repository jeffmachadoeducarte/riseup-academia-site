{
  "name": "rise-up-academia",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da Rise Up Academia — Navegantes/SC",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "lint": "eslint src scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "media": "node scripts/media.mjs",
    "check": "npm run typecheck && npm run lint && npm run build",
    "migrar": "tsx scripts/migrar.ts",
    "semear": "tsx scripts/semear.ts && tsx scripts/semear-conteudo.ts",
    "exportar-demo": "node scripts/exportar-demo.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}